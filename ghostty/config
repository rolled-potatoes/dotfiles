# 테마 설정
theme = zenbones-neobones-light
background-opacity = 1
background-blur-radius = 10

# fonts 
font-family = "Cascadia Code"
font-family = "D2Coding"
font-size = 16
window-inherit-font-size = true

# Pane (분할 창) 이동 설정
keybind = shift+command+bracket_left=goto_split:previous
keybind = shift+command+bracket_right=goto_split:next

# Tab (탭) 이동 설정
keybind = command+bracket_left=previous_tab
keybind = command+bracket_right=next_tab

# quick termnial
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Split (분할 창) 크기 조절 설정
keybind = super+ctrl+left=resize_split:left,30
keybind = super+ctrl+right=resize_split:right,30
keybind = super+ctrl+up=resize_split:up,30
keybind = super+ctrl+down=resize_split:down,30
